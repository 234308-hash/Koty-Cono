{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-storefront.mjs",
  "outputDirectory": "public-site",
  "redirects": [
    {
      "source": "/checkout.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "/",
      "permanent": false
    }
  ]
}
